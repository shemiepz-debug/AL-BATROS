    <section id="sec-settings" class="section">
      <div class="grid-2">
        <div class="card">
          <div class="card-header"><div class="card-title">Company & Invoice Settings</div></div>
          <form id="settingsForm" onsubmit="saveSettings(event)">
            <div class="form-group"><label>Company Name (English)</label><input type="text" id="setCompanyEn" required /></div>
            <div class="form-group"><label>Company Name (Arabic)</label><input type="text" id="setCompanyAr" required /></div>
