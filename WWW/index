  <datalist id="partyDatalist"></datalist>
  <datalist id="itemsDatalist"></datalist>

  <script>
    var STORAGE_KEY = 'albatros_accounts_db_v2';
    var DEFAULT_STATE = {
      lang: 'en',
      settings: {
        companyEn: 'Al-Batros Group For Goods Transport Co.',
        companyAr: 'شركة مجموعة البترس لنقل البضائع',
        addressEn: 'Jaleeb - Al-Shuyoukh, Block 1 - Saud Saad Al-Salahi Complex, 1st Floor - Office 17',
        addressAr: 'جليب الشيوخ - قطعة ١، مجمع سعود سعد الصلاحي، الدور الأول - مكتب ١٧',
        phones: '99417500 - 65143959',
        nextInvoiceNo: 3901,
        nextQuoteNo: 3901,
        nextBillNo: 3901,
        nextReturnNo: 3901,
        logoDataUrl: ''
      },
      invoices: [], quotes: [], purchases: [], returns: [], expenses: [], bankTx: [], parties: [], itemsHistory: []
    };

    function deepCopy(o) { return JSON.parse(JSON.stringify(o)); }

    function loadState() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return deepCopy(DEFAULT_STATE);
        var p = JSON.parse(raw);
        var base = deepCopy(DEFAULT_STATE);
        for (var k in p) { if (k !== 'settings') base[k] = p[k]; }
        if (p.settings) { for (var s in p.settings) base.settings[s] = p.settings[s]; }
        return base;
      } catch (e) { return deepCopy(DEFAULT_STATE); }
    }

    var state = loadState();

    function saveState() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
      if (window.location.protocol.indexOf('http') === 0) {
        fetch('/api/state', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(state)
        }).catch(function () {});
      }
      refreshAll();
    }

    function fmtKwd(num) { return Number(num || 0).toFixed(3) + ' KWD'; }
    function todayStr() { return new Date().toISOString().slice(0, 10); }

    function showToast(msg, type) {
      var wrap = document.getElementById('toastWrap');
      var div = document.createElement('div');
      div.className = 'toast ' + (type || '');
      div.textContent = msg;
      wrap.appendChild(div);
      setTimeout(function () { div.remove(); }, 3200);
    }

    function renderLogo(el) {
      if (!el) return;
      if (state.settings.logoDataUrl) {
        el.innerHTML = '<img src="' + state.settings.logoDataUrl + '" alt="Logo" />';
      } else {
        var svg = document.getElementById('defaultSealSvg');
        el.innerHTML = svg ? svg.outerHTML.replace('style="display:none"', '') : '';
      }
    }

    function handleLogoUpload(e) {
      var file = e.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (ev) {
        state.settings.logoDataUrl = ev.target.result;
        saveState();
        showToast('Logo updated.', 'success');
      };
      reader.readAsDataURL(file);
    }

    function toggleLanguage() {
      state.lang = state.lang === 'en' ? 'ar' : 'en';
      document.documentElement.lang = state.lang;
      document.documentElement.dir = state.lang === 'ar' ? 'rtl' : 'ltr';
      document.getElementById('langBtn').textContent = state.lang === 'en' ? 'العربية' : 'English';
      saveState();
    }

    function switchTab(tabName) {
      document.querySelectorAll('.section').forEach(function (s) { s.classList.remove('active'); });
      var target = document.getElementById('sec-' + tabName);
      if (target) target.classList.add('active');
      document.querySelectorAll('.nav-tab').forEach(function (t) {
        t.classList.toggle('active', t.getAttribute('data-tab') === tabName);
      });
      if (tabName === 'settings') populateSettingsForm();
      if (tabName === 'reports') renderReports();
    }

    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    function addLineItem(desc, qty, rate) {
      var container = document.getElementById('lineItemsContainer');
      var row = document.createElement('div');
      row.className = 'line-row';
      row.innerHTML =
        '<input type="text" class="item-desc" list="itemsDatalist" placeholder="Item / Service description" value="' + (desc || '') + '" oninput="recalcInvoiceModal()" required />' +
        '<input type="number" step="any" min="0.01" class="item-qty" placeholder="Qty" value="' + (qty || 1) + '" oninput="recalcInvoiceModal()" required />' +
        '<input type="number" step="0.001" min="0" class="item-rate" placeholder="Rate (KWD)" value="' + Number(rate || 0).toFixed(3) + '" oninput="recalcInvoiceModal()" required />' +
        '<input type="text" class="item-total" readonly value="0.000" style="background:#f3f4f6; font-weight:700; text-align:right;" />' +
        '<button type="button" class="btn btn-danger btn-sm" onclick="this.parentElement.remove(); recalcInvoiceModal();">✕</button>';
      container.appendChild(row);
      recalcInvoiceModal();
    }

    function recalcInvoiceModal() {
      var grand = 0;
      document.querySelectorAll('#lineItemsContainer .line-row').forEach(function (row) {
        var q = parseFloat(row.querySelector('.item-qty').value) || 0;
        var r = parseFloat(row.querySelector('.item-rate').value) || 0;
        var tot = q * r;
        row.querySelector('.item-total').value = tot.toFixed(3);
        grand += tot;
      });
      document.getElementById('invLiveTotal').textContent = grand.toFixed(3);
    }

    function openNewInvoiceModal() {
      document.getElementById('invoiceForm').reset();
      document.getElementById('invNumber').value = String(state.settings.nextInvoiceNo);
      document.getElementById('invDate').value = todayStr();
      document.getElementById('invPaidNow').value = '0.000';
      document.getElementById('lineItemsContainer').innerHTML = '';
      addLineItem('', 1, 0);
      openModal('invoiceModal');
    }

    function ensureParty(name, role) {
      var clean = (name || '').trim();
      if (!clean) return;
      var exists = state.parties.some(function (p) { return p.name.toLowerCase() === clean.toLowerCase(); });
      if (!exists) state.parties.push({ id: 'PTY-' + Date.now(), name: clean, role: role || 'Customer', phone: '' });
    }

    function recordItem(desc) {
      var clean = (desc || '').trim();
      if (!clean) return;
      if (!state.itemsHistory.some(function (i) { return i.toLowerCase() === clean.toLowerCase(); })) {
        state.itemsHistory.push(clean);
      }
    }

    function saveInvoice(e) {
      e.preventDefault();
      var invNumber = document.getElementById('invNumber').value.trim();
      var date = document.getElementById('invDate').value;
      var mode = document.getElementById('invMode').value;
      var customer = document.getElementById('invCustomer').value.trim();
      var paidNow = parseFloat(document.getElementById('invPaidNow').value) || 0;

      var items = [];
      var total = 0;
      document.querySelectorAll('#lineItemsContainer .line-row').forEach(function (row) {
        var desc = row.querySelector('.item-desc').value.trim();
        var qty = parseFloat(row.querySelector('.item-qty').value) || 0;
        var rate = parseFloat(row.querySelector('.item-rate').value) || 0;
        var amount = Number((qty * rate).toFixed(3));
        if (desc) {
          items.push({ desc: desc, qty: qty, rate: rate, amount: amount });
          total = Number((total + amount).toFixed(3));
          recordItem(desc);
        }
      });

      if (!items.length) { showToast('Add at least one item.', 'error'); return; }
      if (mode !== 'CREDIT' && paidNow === 0) paidNow = total;
      paidNow = Math.min(paidNow, total);
      var balance = Number((total - paidNow).toFixed(3));
      var status = balance <= 0.0001 ? 'PAID' : (paidNow > 0 ? 'PARTIAL' : 'UNPAID');

      ensureParty(customer, 'Customer');

      var invObj = {
        id: 'INV-' + Date.now(), number: invNumber, date: date, mode: mode,
        customer: customer, items: items, total: total, paid: paidNow, balance: balance, status: status
      };
      state.invoices.unshift(invObj);

      var numVal = parseInt(invNumber.replace(/\D+/g, ''), 10);
      if (!isNaN(numVal) && numVal >= state.settings.nextInvoiceNo) state.settings.nextInvoiceNo = numVal + 1;

      if (paidNow > 0) {
        var acc = mode === 'KNET' ? 'KNET' : (mode === 'BANK' ? 'BANK' : 'CASH');
        state.bankTx.unshift({
          id: 'BTX-' + Date.now(), date: date, account: acc, direction: 'IN',
          description: 'Invoice #' + invNumber + ' - ' + customer, amount: paidNow, cleared: true
        });
      }

      saveState();
      closeModal('invoiceModal');
      showToast('Invoice #' + invNumber + ' saved.', 'success');
      openPrintModal(invObj.id);
    }

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, function (m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function openPrintModal(id) {
      var inv = state.invoices.find(function (x) { return x.id === id; });
      if (!inv) return;
      var s = state.settings;
      var rows = inv.items.map(function (it, i) {
        return '<tr><td>' + (i + 1) + '</td><td>' + escapeHtml(it.desc) + '</td><td class="num">' + it.qty +
          '</td><td class="num">' + Number(it.rate).toFixed(3) + '</td><td class="num">' + Number(it.amount).toFixed(3) + '</td></tr>';
      }).join('');

      document.getElementById('printableArea').innerHTML =
        '<div class="inv-sheet">' +
          '<div class="inv-header-top">' +
            '<div class="inv-en"><div style="font-weight:800;font-size:14px;">' + escapeHtml(s.companyEn) + '</div><div>' + escapeHtml(s.addressEn) + '</div><div>Tel: ' + escapeHtml(s.phones) + '</div><div style="margin-top:6px;"><strong>Date:</strong> ' + escapeHtml(inv.date) + '</div><div><strong>Sold To:</strong> ' + escapeHtml(inv.customer) + '</div></div>' +
            '<div class="inv-seal"><div id="printModalLogoBox"></div><div style="font-size:11px;font-weight:700;margin-top:4px;">' + escapeHtml(inv.mode) + ' INVOICE</div><div class="inv-no-badge">No.: ' + escapeHtml(inv.number) + '</div></div>' +
            '<div class="inv-ar"><div style="font-weight:800;font-size:14px;">' + escapeHtml(s.companyAr) + '</div><div>' + escapeHtml(s.addressAr) + '</div><div>نقال: ' + escapeHtml(s.phones) + '</div><div style="margin-top:6px;"><strong>التاريخ:</strong> ' + escapeHtml(inv.date) + '</div><div><strong>السيد / السادة:</strong> ' + escapeHtml(inv.customer) + '</div></div>' +
          '</div>' +
          '<table style="margin-bottom:10px;"><thead><tr><th>#</th><th>Description / البيان</th><th class="num">Qty</th><th class="num">Rate (KWD)</th><th class="num">Total (KWD)</th></tr></thead><tbody>' + rows + '</tbody></table>' +
          '<div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;padding-top:8px;">' +
            '<div style="font-size:12px;"><div>Receiver Signature: ___________________</div><div style="margin-top:10px;">Authorized Signatory: ___________________</div></div>' +
            '<div style="text-align:right;font-size:14px;"><div><strong>Grand Total: ' + fmtKwd(inv.total) + '</strong></div><div>Paid: ' + fmtKwd(inv.paid) + '</div><div>Balance Due: ' + fmtKwd(inv.balance) + '</div></div>' +
          '</div>' +
        '</div>';

      renderLogo(document.getElementById('printModalLogoBox'));
      openModal('printModal');
    }

    function saveQuote(e) {
      e.preventDefault();
      var number = document.getElementById('quoteNumber').value.trim();
      var date = document.getElementById('quoteDate').value;
      var customer = document.getElementById('quoteCustomer').value.trim();
      var desc = document.getElementById('quoteItemDesc').value.trim();
      var qty = parseFloat(document.getElementById('quoteQty').value) || 1;
      var rate = parseFloat(document.getElementById('quoteRate').value) || 0;
      var amount = Number((qty * rate).toFixed(3));
      ensureParty(customer, 'Customer');
      recordItem(desc);
      state.quotes.unshift({ id: 'QUO-' + Date.now(), number: number, date: date, customer: customer, desc: desc, qty: qty, rate: rate, amount: amount, status: 'DRAFT' });
      state.settings.nextQuoteNo += 1;
      saveState();
      document.getElementById('quoteForm').reset();
      initDefaults();
      showToast('Quote saved.', 'success');
    }

    function convertQuoteToInvoice(id) {
      var q = state.quotes.find(function (x) { return x.id === id; });
      if (!q) return;
      var invNum = String(state.settings.nextInvoiceNo);
      state.invoices.unshift({
        id: 'INV-' + Date.now(), number: invNum, date: todayStr(), mode: 'CREDIT',
        customer: q.customer, items: [{ desc: q.desc, qty: q.qty, rate: q.rate, amount: q.amount }],
        total: q.amount, paid: 0, balance: q.amount, status: 'UNPAID'
      });
      state.settings.nextInvoiceNo += 1;
      q.status = 'INVOICED';
      saveState();
      showToast('Converted to Invoice #' + invNum, 'success');
      switchTab('sales');
    }

    function savePurchase(e) {
      e.preventDefault();
      var number = document.getElementById('billNumber').value.trim();
      var date = document.getElementById('billDate').value;
      var vendor = document.getElementById('billVendor').value.trim();
      var desc = document.getElementById('billDesc').value.trim();
      var amount = Number((parseFloat(document.getElementById('billAmount').value) || 0).toFixed(3));
      var paidAcc = document.getElementById('billPaidAccount').value;
      var paid = paidAcc === 'UNPAID' ? 0 : amount;
      var balance = Number((amount - paid).toFixed(3));
      ensureParty(vendor, 'Vendor');
      recordItem(desc);
      state.purchases.unshift({ id: 'PUR-' + Date.now(), number: number, date: date, vendor: vendor, desc: desc, total: amount, paid: paid, balance: balance, status: balance <= 0.0001 ? 'PAID' : 'UNPAID' });
      if (paid > 0) {
        state.bankTx.unshift({ id: 'BTX-' + Date.now(), date: date, account: paidAcc, direction: 'OUT', description: 'Bill #' + number + ' - ' + vendor, amount: paid, cleared: true });
      }
      state.settings.nextBillNo += 1;
      saveState();
      document.getElementById('purchaseForm').reset();
      initDefaults();
      showToast('Vendor bill saved.', 'success');
    }

    function saveReturn(e) {
      e.preventDefault();
      var type = document.getElementById('returnType').value;
      var date = document.getElementById('returnDate').value;
      var party = document.getElementById('returnParty').value.trim();
      var reason = document.getElementById('returnReason').value.trim();
      var amount = Number((parseFloat(document.getElementById('returnAmount').value) || 0).toFixed(3));
      state.returns.unshift({ id: 'RET-' + Date.now(), number: (type === 'SALES_RETURN' ? 'CN-' : 'DN-') + state.settings.nextReturnNo, type: type, date: date, party: party, reason: reason, amount: amount });
      state.settings.nextReturnNo += 1;
      saveState();
      document.getElementById('returnForm').reset();
      initDefaults();
      showToast('Return recorded.', 'success');
    }

    function saveExpense(e) {
      e.preventDefault();
      var date = document.getElementById('expDate').value;
      var category = document.getElementById('expCategory').value;
      var account = document.getElementById('expAccount').value;
      var notes = document.getElementById('expNotes').value.trim();
      var amount = Number((parseFloat(document.getElementById('expAmount').value) || 0).toFixed(3));
      state.expenses.unshift({ id: 'EXP-' + Date.now(), date: date, category: category, account: account, notes: notes, amount: amount });
      state.bankTx.unshift({ id: 'BTX-' + Date.now(), date: date, account: account, direction: 'OUT', description: 'Expense: ' + category + (notes ? ' - ' + notes : ''), amount: amount, cleared: true });
      saveState();
      document.getElementById('expenseForm').reset();
      initDefaults();
      showToast('Expense saved.', 'success');
    }

    function deleteExpense(id) {
      state.expenses = state.expenses.filter(function (x) { return x.id !== id; });
      saveState();
    }

    function saveBankTx(e) {
      e.preventDefault();
      state.bankTx.unshift({
        id: 'BTX-' + Date.now(), date: document.getElementById('bankTxDate').value,
        account: document.getElementById('bankTxAccount').value, direction: document.getElementById('bankTxDir').value,
        description: document.getElementById('bankTxDesc').value.trim(),
        amount: Number((parseFloat(document.getElementById('bankTxAmount').value) || 0).toFixed(3)), cleared: false
      });
      saveState();
      document.getElementById('bankTxForm').reset();
      initDefaults();
      showToast('Entry recorded.', 'success');
    }

    function toggleCleared(id) {
      var tx = state.bankTx.find(function (x) { return x.id === id; });
      if (tx) { tx.cleared = !tx.cleared; saveState(); }
    }

    function saveParty(e) {
      e.preventDefault();
      var name = document.getElementById('partyName').value.trim();
      var role = document.getElementById('partyRole').value;
      var phone = document.getElementById('partyPhone').value.trim();
      var ex = state.parties.find(function (p) { return p.name.toLowerCase() === name.toLowerCase(); });
      if (ex) { ex.role = role; ex.phone = phone; }
      else state.parties.push({ id: 'PTY-' + Date.now(), name: name, role: role, phone: phone });
      saveState();
      document.getElementById('partyForm').reset();
      showToast('Party saved.', 'success');
    }

    function populateSettingsForm() {
      var s = state.settings;
      document.getElementById('setCompanyEn').value = s.companyEn;
      document.getElementById('setCompanyAr').value = s.companyAr;
      document.getElementById('setAddressEn').value = s.addressEn;
      document.getElementById('setAddressAr').value = s.addressAr;
      document.getElementById('setPhones').value = s.phones;
      document.getElementById('setNextInvNo').value = s.nextInvoiceNo;
    }

    function saveSettings(e) {
      e.preventDefault();
      state.settings.companyEn = document.getElementById('setCompanyEn').value.trim();
      state.settings.companyAr = document.getElementById('setCompanyAr').value.trim();
      state.settings.addressEn = document.getElementById('setAddressEn').value.trim();
      state.settings.addressAr = document.getElementById('setAddressAr').value.trim();
      state.settings.phones = document.getElementById('setPhones').value.trim();
      state.settings.nextInvoiceNo = parseInt(document.getElementById('setNextInvNo').value, 10) || 3901;
      saveState();
      showToast('Settings saved.', 'success');
    }

    function getBalances() {
      var b = { CASH: 0, KNET: 0, BANK: 0 };
      state.bankTx.forEach(function (tx) {
        var a = b[tx.account] !== undefined ? tx.account : 'CASH';
        b[a] += tx.direction === 'IN' ? Number(tx.amount || 0) : -Number(tx.amount || 0);
      });
      return b;
    }

    function renderReports() {
      var f = document.getElementById('repFrom').value || '0000-01-01';
      var t = document.getElementById('repTo').value || '9999-12-31';
      var sales = state.invoices.filter(function (i) { return i.date >= f && i.date <= t; }).reduce(function (s, i) { return s + Number(i.total || 0); }, 0);
      var bills = state.purchases.filter(function (p) { return p.date >= f && p.date <= t; }).reduce(function (s, p) { return s + Number(p.total || 0); }, 0);
      var exps = state.expenses.filter(function (x) { return x.date >= f && x.date <= t; }).reduce(function (s, x) { return s + Number(x.amount || 0); }, 0);
      document.getElementById('repSales').textContent = fmtKwd(sales);
      document.getElementById('repCosts').textContent = fmtKwd(bills + exps);
      document.getElementById('repNet').textContent = fmtKwd(sales - bills - exps);
    }

    function exportInvoicesCsv() {
      var lines = ['InvoiceNo,Date,Customer,Mode,Total_KWD,Paid_KWD,Balance_KWD,Status'];
      state.invoices.forEach(function (inv) {
        lines.push(['"' + inv.number + '"', '"' + inv.date + '"', '"' + inv.customer + '"', '"' + inv.mode + '"', Number(inv.total).toFixed(3), Number(inv.paid).toFixed(3), Number(inv.balance).toFixed(3), '"' + inv.status + '"'].join(','));
      });
      var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'AlBatros-Invoices-' + todayStr() + '.csv';
      a.click();
    }

    function downloadJsonBackup() {
      var blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'AlBatros-Backup-' + todayStr() + '.json';
      a.click();
    }

    function restoreJsonBackup(e) {
      var file = e.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (ev) {
        try {
          state = JSON.parse(ev.target.result);
          saveState();
          showToast('Backup restored.', 'success');
        } catch (err) { showToast('Invalid backup file.', 'error'); }
      };
      reader.readAsText(file);
    }

    function resetAllData() {
      state = deepCopy(DEFAULT_STATE);
      saveState();
      initDefaults();
      showToast('Data reset to 3901.', 'success');
    }

    function refreshAll() {
      renderLogo(document.getElementById('headerLogoBox'));
      document.getElementById('uiCompanyTitle').textContent = state.settings.companyEn;
      document.getElementById('uiCompanySub').textContent = state.settings.companyAr + ' • KWD';

      document.getElementById('partyDatalist').innerHTML = state.parties.map(function (p) { return '<option value="' + escapeHtml(p.name) + '"></option>'; }).join('');
      document.getElementById('itemsDatalist').innerHTML = state.itemsHistory.map(function (it) { return '<option value="' + escapeHtml(it) + '"></option>'; }).join('');

      var t = todayStr();
      var todaySales = state.invoices.filter(function (i) { return i.date === t; }).reduce(function (s, i) { return s + Number(i.total || 0); }, 0);
      var totalSales = state.invoices.reduce(function (s, i) { return s + Number(i.total || 0); }, 0);
      var receivables = state.invoices.reduce(function (s, i) { return s + Number(i.balance || 0); }, 0);
      var bills = state.purchases.reduce(function (s, p) { return s + Number(p.total || 0); }, 0);
      var exps = state.expenses.reduce(function (s, x) { return s + Number(x.amount || 0); }, 0);
      var b = getBalances();

      document.getElementById('kpiTodaySales').textContent = fmtKwd(todaySales);
      document.getElementById('kpiTotalSales').textContent = fmtKwd(totalSales);
      document.getElementById('kpiReceivables').textContent = fmtKwd(receivables);
      document.getElementById('kpiOutflow').textContent = fmtKwd(bills + exps);
      document.getElementById('kpiLiquidCash').textContent = fmtKwd(b.CASH + b.KNET + b.BANK);

      document.getElementById('balCash').textContent = fmtKwd(b.CASH);
      document.getElementById('balKnet').textContent = fmtKwd(b.KNET);
      document.getElementById('balBank').textContent = fmtKwd(b.BANK);

      document.getElementById('dashRecentInvoices').innerHTML = state.invoices.slice(0, 8).map(function (inv) {
        return '<tr><td><strong>' + escapeHtml(inv.number) + '</strong></td><td>' + escapeHtml(inv.date) + '</td><td>' + escapeHtml(inv.customer) + '</td><td>' + escapeHtml(inv.mode) + '</td><td class="num">' + Number(inv.total).toFixed(3) + '</td><td class="num">' + Number(inv.balance).toFixed(3) + '</td><td><span class="badge badge-' + inv.status.toLowerCase() + '">' + inv.status + '</span></td><td><button class="btn btn-outline btn-sm" onclick="openPrintModal(\'' + inv.id + '\')">Print</button></td></tr>';
      }).join('') || '<tr><td colspan="8" style="text-align:center;color:var(--muted);">No invoices yet.</td></tr>';

      renderSalesTable();

      document.getElementById('quotesTableBody').innerHTML = state.quotes.map(function (q) {
        return '<tr><td>' + escapeHtml(q.number) + '</td><td>' + escapeHtml(q.date) + '</td><td>' + escapeHtml(q.customer) + '</td><td>' + escapeHtml(q.desc) + '</td><td class="num">' + Number(q.amount).toFixed(3) + '</td><td><span class="badge badge-draft">' + q.status + '</span></td><td>' + (q.status !== 'INVOICED' ? '<button class="btn btn-primary btn-sm" onclick="convertQuoteToInvoice(\'' + q.id + '\')">Convert</button>' : 'Invoiced') + '</td></tr>';
      }).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--muted);">No quotes yet.</td></tr>';

      document.getElementById('purchasesTableBody').innerHTML = state.purchases.map(function (p) {
        return '<tr><td>' + escapeHtml(p.number) + '</td><td>' + escapeHtml(p.date) + '</td><td>' + escapeHtml(p.vendor) + '</td><td>' + escapeHtml(p.desc) + '</td><td class="num">' + Number(p.total).toFixed(3) + '</td><td class="num">' + Number(p.balance).toFixed(3) + '</td><td><span class="badge badge-' + p.status.toLowerCase() + '">' + p.status + '</span></td></tr>';
      }).join('') || '<tr><td colspan="7" style="text-align:center;color:var(--muted);">No bills yet.</td></tr>';

      document.getElementById('returnsTableBody').innerHTML = state.returns.map(function (r) {
        return '<tr><td>' + escapeHtml(r.number) + '</td><td>' + escapeHtml(r.type) + '</td><td>' + escapeHtml(r.date) + '</td><td>' + escapeHtml(r.party) + '</td><td>' + escapeHtml(r.reason) + '</td><td class="num">' + Number(r.amount).toFixed(3) + '</td></tr>';
      }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);">No returns yet.</td></tr>';

      document.getElementById('expensesTableBody').innerHTML = state.expenses.map(function (ex) {
        return '<tr><td>' + escapeHtml(ex.date) + '</td><td>' + escapeHtml(ex.category) + '</td><td>' + escapeHtml(ex.account) + '</td><td>' + escapeHtml(ex.notes) + '</td><td class="num">' + Number(ex.amount).toFixed(3) + '</td><td><button class="btn btn-danger btn-sm" onclick="deleteExpense(\'' + ex.id + '\')">Delete</button></td></tr>';
      }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);">No expenses yet.</td></tr>';

      document.getElementById('bankTxTableBody').innerHTML = state.bankTx.map(function (tx) {
        return '<tr><td>' + escapeHtml(tx.date) + '</td><td>' + escapeHtml(tx.account) + '</td><td>' + escapeHtml(tx.description) + '</td><td class="num">' + (tx.direction === 'IN' ? Number(tx.amount).toFixed(3) : '0.000') + '</td><td class="num">' + (tx.direction === 'OUT' ? Number(tx.amount).toFixed(3) : '0.000') + '</td><td><button class="btn btn-outline btn-sm" onclick="toggleCleared(\'' + tx.id + '\')">' + (tx.cleared ? '✓ Cleared' : 'Pending') + '</button></td></tr>';
      }).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);">No entries yet.</td></tr>';

      document.getElementById('contactsTableBody').innerHTML = state.parties.map(function (p) {
        var rec = state.invoices.filter(function (i) { return i.customer.toLowerCase() === p.name.toLowerCase(); }).reduce(function (s, i) { return s + Number(i.balance || 0); }, 0);
        var pay = state.purchases.filter(function (pur) { return pur.vendor.toLowerCase() === p.name.toLowerCase(); }).reduce(function (s, pur) { return s + Number(pur.balance || 0); }, 0);
        return '<tr><td><strong>' + escapeHtml(p.name) + '</strong></td><td>' + escapeHtml(p.role) + '</td><td>' + escapeHtml(p.phone || '-') + '</td><td class="num">' + rec.toFixed(3) + '</td><td class="num">' + pay.toFixed(3) + '</td></tr>';
      }).join('') || '<tr><td colspan="5" style="text-align:center;color:var(--muted);">No parties yet.</td></tr>';
    }

    function renderSalesTable() {
      var q = (document.getElementById('salesSearch').value || '').toLowerCase().trim();
      var list = state.invoices.filter(function (inv) {
        return !q || String(inv.number).toLowerCase().indexOf(q) !== -1 || String(inv.customer).toLowerCase().indexOf(q) !== -1;
      });
      document.getElementById('salesTableBody').innerHTML = list.map(function (inv) {
        return '<tr><td><strong>' + escapeHtml(inv.number) + '</strong></td><td>' + escapeHtml(inv.date) + '</td><td>' + escapeHtml(inv.customer) + '</td><td>' + escapeHtml(inv.mode) + '</td><td class="num">' + Number(inv.total).toFixed(3) + '</td><td class="num">' + Number(inv.paid).toFixed(3) + '</td><td class="num">' + Number(inv.balance).toFixed(3) + '</td><td><span class="badge badge-' + inv.status.toLowerCase() + '">' + inv.status + '</span></td><td><button class="btn btn-outline btn-sm" onclick="openPrintModal(\'' + inv.id + '\')">Print</button></td></tr>';
      }).join('') || '<tr><td colspan="9" style="text-align:center;color:var(--muted);">No invoices found.</td></tr>';
    }

    function initDefaults() {
      var t = todayStr();
      ['quoteDate', 'billDate', 'returnDate', 'expDate', 'bankTxDate', 'repFrom', 'repTo'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el && !el.value) el.value = t;
      });
      document.getElementById('quoteNumber').value = String(state.settings.nextQuoteNo);
      document.getElementById('billNumber').value = String(state.settings.nextBillNo);
    }

    if (window.location.protocol.indexOf('http') === 0) {
      fetch('/api/state').then(function (r) { return r.json(); }).then(function (srv) {
        if (srv && srv.settings) {
          state = srv;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          initDefaults();
          refreshAll();
        }
      }).catch(function () {});
    }

    initDefaults();
    refreshAll();
  </script>
</body>
</html>
